# Data Quality Validation Framework - Environment Configuration

# API Settings
API_TITLE=Data Quality Validation Framework
API_VERSION=1.0.0
DEBUG=False

# Database Settings
DATABASE_URL=postgresql://username:password@localhost:5432/data_quality_db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=True
DATABASE_POOL_RECYCLE=3600

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_ASYNC_TASKS=True
ENABLE_CACHING=True

# Redis Caching Settings
REDIS_ENABLED=True
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5
REDIS_VALIDATION_TTL=1800
REDIS_METRICS_TTL=3600
REDIS_DATASET_TTL=7200
REDIS_ANOMALY_TTL=1800
REDIS_SESSION_TTL=86400

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Job Search Automation ────────────────────────────────────────────────────

# ── AI Provider — pick ONE and set the matching key ─────────────────────────
# Options: gemini | groq | openai | huggingface | ollama | anthropic | none
AI_PROVIDER=none

# Google Gemini — FREE 1,500 req/day  →  get key at https://ai.google.dev
# Install: pip install google-genai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — FREE ~14,400 req/day (ultra-fast Llama 3)  →  https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — pay-as-you-go, gpt-4o-mini costs ~$0.01 per 10 job analyses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HuggingFace Inference API — FREE tier  →  https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Ollama — 100% FREE, runs locally  →  https://ollama.ai  then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude — original option (paid)
ANTHROPIC_API_KEY=

# Master Resume Text — paste full resume here
# For multiline values use a single-quoted string in .env or set via environment
MASTER_RESUME_TEXT=Jaswanth Ram Nagabhyrava | Data Analyst with 3+ years of experience analyzing operational and sales datasets. Skills: SQL (Advanced), Python (Pandas, NumPy), Power BI, Tableau, ETL/ELT Pipelines, dbt, Apache Airflow, Snowflake, Redshift, PostgreSQL, AWS (S3, Lambda), Salesforce, ERP Systems (SAP, NetSuite), Time Series Forecasting, Regression Analysis, A/B Testing. Experience: Data Analyst at Rishi Inc (Mar 2024-Present) - Built Power BI dashboards reducing manual reporting by 45%; designed SQL pipelines integrating Salesforce and ERP processing 500K+ records/month improving accuracy by 30%; developed Python ETL workflows; implemented automated refresh pipelines with data quality checks. Data Analyst at Pioneer Auto World (Aug 2021-Dec 2022) - Consolidated sales/service/inventory datasets reducing reporting prep by 60%; built Tableau dashboards improving operational visibility by 40%; applied time-series forecasting improving planning accuracy by 25%; automated monthly reporting reducing prep from 3 hours to 20 minutes; $28K quarterly cost savings. Education: MS Information Systems, UMBC. Projects: Baltimore Crime Analysis (1M+ records, Tableau, 90% reporting reduction), F1 Lap Time Prediction (93% R²), Off-Task Behavior Prediction (ML, Flask).

# Notion job tracker database ID (auto-populated after first /api/reports/trigger)
NOTION_JOB_DATABASE_ID=
