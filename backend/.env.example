# Data Quality Validation Framework - Environment Configuration

# API Settings
API_TITLE=Data Quality Validation Framework
API_VERSION=1.0.0
DEBUG=False

# Database Settings
DATABASE_URL=postgresql://username:password@localhost:5432/data_quality_db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=True
DATABASE_POOL_RECYCLE=3600

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_ASYNC_TASKS=True
ENABLE_CACHING=True

# Redis Caching Settings
REDIS_ENABLED=True
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5
REDIS_VALIDATION_TTL=1800
REDIS_METRICS_TTL=3600
REDIS_DATASET_TTL=7200
REDIS_ANOMALY_TTL=1800
REDIS_SESSION_TTL=86400
